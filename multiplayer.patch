index 0000000..5c7ee83
--- /dev/null
+++ b/server/index.cjs
@@ -0,0 +1,149 @@
+const http = require('node:http');
+const fs = require('node:fs');
+const path = require('node:path');
+const crypto = require('node:crypto');
+const { WebSocketServer, WebSocket } = require('ws');
+
+const ROOT = path.resolve(__dirname, '..');
+const PORT = process.env.PORT === undefined ? 3000 : Number(process.env.PORT);
+const DATA = process.env.SCORES_FILE || path.join(__dirname, 'scores.json');
+const WIDTH = 960, HEIGHT = 600, TICK = 1 / 30, LIMIT = 180;
+const rooms = new Map();
+const types = { '.html': 'text/html; charset=utf-8', '.png': 'image/png', '.js': 'text/javascript; charset=utf-8', '.css': 'text/css; charset=utf-8' };
+
+function leaderboard() {
+  try { const data = JSON.parse(fs.readFileSync(DATA, 'utf8')); return Array.isArray(data) ? data.slice(0, 50) : []; }
+  catch { return []; }
+}
+function saveScore(room) {
+  if (room.saved || !room.started || room.players.length !== 2) return;
+  room.saved = true;
+  const entry = { mode: room.mode, players: room.players.map(p => ({ name: p.name, kills: p.kills })),
+    score: room.score, sector: room.sector, winner: room.mode === 'versus' ?
+      (room.players[0].kills === room.players[1].kills ? 'TIE' : room.players.reduce((a, b) => a.kills > b.kills ? a : b).name) : null,
+    date: new Date().toISOString() };
+  const rows = [entry, ...leaderboard()].sort((a, b) => b.score - a.score).slice(0, 50);
+  fs.mkdirSync(path.dirname(DATA), { recursive: true });
+  const tmp = DATA + '.tmp'; fs.writeFileSync(tmp, JSON.stringify(rows, null, 2)); fs.renameSync(tmp, DATA);
+}
+function send(ws, obj) { if (ws.readyState === WebSocket.OPEN) ws.send(JSON.stringify(obj)); }
+function broadcast(room, obj) { for (const p of room.players) send(p.ws, obj); }
+function newRoom(mode) {
+  if (rooms.size >= 100) return null;
+  let code; do { code = crypto.randomBytes(3).toString('hex').toUpperCase(); } while (rooms.has(code));
+  const room = { code, mode, players: [], enemies: [], bullets: [], sector: 1, score: 0, time: 0,
+    spawn: 1, spawned: 0, quota: 16, seq: 0, started: false, ended: false, saved: false };
+  rooms.set(code, room); return room;
+}
+function join(ws, msg) {
+  if (ws.room) return send(ws, { type: 'error', message: 'Already in a room' });
+  const name = String(msg.name || '').trim().replace(/[^\p{L}\p{N} _-]/gu, '').slice(0, 20);
+  if (!name) return send(ws, { type: 'error', message: 'Enter a player name' });
+  let room;
+  if (msg.type === 'create' && ['coop', 'versus'].includes(msg.mode)) room = newRoom(msg.mode);
+  else if (msg.type === 'join' && typeof msg.code === 'string') room = rooms.get(msg.code.trim().toUpperCase());
+  if (!room || room.players.length >= 2 || room.ended) return send(ws, { type: 'error', message: 'Room unavailable or full' });
+  const player = { id: crypto.randomUUID(), name, ws, x: room.players.length ? 620 : 340, y: 520,
+    hp: 5, kills: 0, inv: 0, fire: 0, dash: 0, nova: 1,
+    input: { x: 0, y: 0 }, action: null };
+  room.players.push(player); ws.room = room; ws.player = player;
+  send(ws, { type: 'joined', code: room.code, id: player.id, mode: room.mode });
+  broadcast(room, { type: 'roster', players: room.players.map(p => p.name), ready: room.players.length === 2 });
+  if (room.players.length === 2) { room.started = true; broadcast(room, { type: 'start' }); }
+}
+function end(room, reason) {
+  if (room.ended) return;
+  room.ended = true;
+  try { saveScore(room); } catch (err) { console.error('Could not save score:', err); }
+  broadcast(room, { type: 'end', reason, score: room.score,
+    winner: room.mode === 'versus' ? (room.players[0].kills === room.players[1].kills ? 'Tie' : room.players.reduce((a, b) => a.kills > b.kills ? a : b).name) : null });
+  rooms.delete(room.code);
+}
+function hit(a, b, radius) { return Math.hypot(a.x - b.x, a.y - b.y) < radius; }
+function damagePlayer(room, p) {
+  p.hp--; p.inv = 1.4;
+  if (p.hp <= 0 && room.mode === 'versus') {
+    p.hp = 5; p.inv = 2.5; p.x = room.players.indexOf(p) ? 620 : 340; p.y = 520;
+  }
+}
+function simulate(room) {
+  if (!room.started || room.ended) return;
+  room.time += TICK; room.spawn -= TICK;
+  if (room.spawn <= 0 && room.spawned < room.quota && room.enemies.length < 18) {
+    room.enemies.push({ id: ++room.seq, x: 40 + Math.random() * 880, y: -20, hp: 2 + Math.floor(room.sector / 3),
+      max: 2 + Math.floor(room.sector / 3), speed: 65 + room.sector * 7, drift: Math.random() * 6, fire: 2 });
+    room.spawned++; room.spawn = Math.max(.4, 1.05 - room.sector * .04);
+  }
+  for (const p of room.players) {
+    p.inv = Math.max(0, p.inv - TICK); p.dash = Math.max(0, p.dash - TICK); p.fire -= TICK;
+    const { x, y } = p.input; p.x = Math.max(18, Math.min(WIDTH - 18, p.x + x * 300 * TICK));
+    p.y = Math.max(35, Math.min(HEIGHT - 18, p.y + y * 300 * TICK));
+    if (p.action === 'dash' && p.dash <= 0) { p.y = Math.max(35, p.y - 110); p.inv = .5; p.dash = 3; }
+    if (p.action === 'nova' && p.nova > 0) { p.nova--; room.bullets = room.bullets.filter(b => b.owner);
+      for (const e of room.enemies) if (hit(e, p, 180)) { e.hp -= 5; e.lastHit = p.id; } }
+    p.action = null;
+    if (p.hp > 0 && p.fire <= 0) { room.bullets.push({ x: p.x, y: p.y - 18, vx: 0, vy: -520, owner: p.id }); p.fire = .18; }
+  }
+  for (const e of room.enemies) {
+    e.y += e.speed * TICK; e.x += Math.sin(room.time * 2 + e.drift) * 30 * TICK; e.fire -= TICK;
+    if (e.fire <= 0 && e.y < 470) {
+      const living = room.players.filter(p => p.hp > 0);
+      if (living.length) { const p = living[Math.floor(Math.random() * living.length)], a = Math.atan2(p.y - e.y, p.x - e.x);
+        room.bullets.push({ x: e.x, y: e.y, vx: Math.cos(a) * 135, vy: Math.sin(a) * 135, owner: null }); }
+      e.fire = 2.2;
+    }
+    for (const p of room.players) if (p.hp > 0 && p.inv <= 0 && hit(p, e, 25)) damagePlayer(room, p);
+  }
+  for (const b of room.bullets) {
+    b.x += b.vx * TICK; b.y += b.vy * TICK;
+    if (b.owner) {
+      for (const e of room.enemies) if (e.hp > 0 && hit(b, e, 19)) { e.hp--; e.lastHit = b.owner; b.dead = true; break; }
+    } else for (const p of room.players) if (p.hp > 0 && p.inv <= 0 && hit(b, p, 17)) { damagePlayer(room, p); b.dead = true; break; }
+  }
+  for (const e of room.enemies) if (e.hp <= 0) { room.score += 100;
+    const killer = room.players.find(p => p.id === e.lastHit); if (killer) killer.kills++; }
+  if (room.mode === 'coop' && room.enemies.some(e => e.y > HEIGHT + 20)) return end(room, 'An enemy escaped');
+  room.enemies = room.enemies.filter(e => e.hp > 0 && e.y <= HEIGHT + 20);
+  room.bullets = room.bullets.filter(b => !b.dead && b.y > -30 && b.y < HEIGHT + 30 && b.x > -30 && b.x < WIDTH + 30).slice(-220);
+  if (room.mode === 'coop' && room.players.every(p => p.hp <= 0)) return end(room, 'Both ships were destroyed');
+  if (room.mode === 'versus' && room.time >= LIMIT) return end(room, 'Time is up');
+  if (room.spawned === room.quota && room.enemies.length === 0) {
+    room.sector++; room.spawned = 0; room.quota = Math.min(50, 14 + room.sector * 2);
+    for (const p of room.players) { p.nova = Math.min(3, p.nova + 1); p.hp = Math.min(5, p.hp + 1); }
+  }
+  broadcast(room, { type: 'state', mode: room.mode, time: room.time, remaining: Math.max(0, LIMIT - room.time),
+    sector: room.sector, score: room.score, players: room.players.map(({ id, name, x, y, hp, kills, nova, dash }) => ({ id, name, x, y, hp, kills, nova, dash })),
+    enemies: room.enemies.map(({ id, x, y, hp, max }) => ({ id, x, y, hp, max })), bullets: room.bullets });
+}
+
+const server = http.createServer((req, res) => {
+  if (req.url === '/api/leaderboard') { res.writeHead(200, { 'Content-Type': 'application/json', 'Cache-Control': 'no-store' });
+    return res.end(JSON.stringify(leaderboard())); }
+  let pathname; try { pathname = decodeURIComponent((req.url || '/').split('?')[0]); }
+  catch { res.writeHead(400); return res.end('Bad request'); }
+  const allowed = pathname === '/' ? '/index.html' : pathname;
+  if (!['/index.html', '/multiplayer.html'].includes(allowed) && !/^\/png\/[\w .-]+\.png$/.test(allowed)) {
+    res.writeHead(404); return res.end('Not found');
+  }
+  const file = path.join(ROOT, allowed);
+  fs.readFile(file, (err, data) => { if (err) { res.writeHead(404); return res.end('Not found'); }
+    res.writeHead(200, { 'Content-Type': types[path.extname(file)] || 'application/octet-stream', 'X-Content-Type-Options': 'nosniff' }); res.end(data); });
+});
+const wss = new WebSocketServer({ server, path: '/socket', maxPayload: 512 });
+wss.on('connection', ws => {
+  ws.on('message', raw => { let msg; try { msg = JSON.parse(raw); } catch { return; }
+    if (msg.type === 'create' || msg.type === 'join') return join(ws, msg);
+    const p = ws.player; if (!p || !ws.room || ws.room.ended) return;
+    if (msg.type === 'input') {
+      p.input = { x: Math.max(-1, Math.min(1, Number(msg.x) || 0)), y: Math.max(-1, Math.min(1, Number(msg.y) || 0)) };
+      if (['dash', 'nova'].includes(msg.action)) p.action = msg.action;
+    }
+  });
+  ws.on('close', () => { if (ws.room && !ws.room.ended) {
+    const room = ws.room; if (room.started) end(room, 'A player disconnected');
+    else { rooms.delete(room.code); broadcast(room, { type: 'end', reason: 'Player left the room' }); }
+  } });
+});
+const timer = setInterval(() => { for (const room of rooms.values()) simulate(room); }, 1000 / 30);
+server.listen(PORT, '0.0.0.0', () => console.log(`Neon Drift multiplayer listening on ${server.address().port}`));
+module.exports = { server, wss, timer, rooms, simulate };
diff --git a/server/test/multiplayer.test.cjs b/server/test/multiplayer.test.cjs
new file mode 100644
index 0000000..b328cf0
--- /dev/null
+++ b/server/test/multiplayer.test.cjs
@@ -0,0 +1,100 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const WebSocket = require('ws');
+
+const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'neondrift-'));
+process.env.PORT = '0';
+process.env.SCORES_FILE = path.join(dir, 'scores.json');
+const { server, wss, timer, rooms, simulate } = require('../index.cjs');
+
+function connect(port) {
+  return new Promise((resolve, reject) => {
+    const ws = new WebSocket(`ws://127.0.0.1:${port}/socket`);
+    ws.once('open', () => resolve(ws)); ws.once('error', reject);
+  });
+}
+function message(ws, type) {
+  return new Promise((resolve, reject) => {
+    const timeout = setTimeout(() => { ws.off('message', handler); reject(new Error(`No ${type} response`)); }, 3000);
+    function handler(data) { const parsed = JSON.parse(data); if (parsed.type !== type) return;
+      clearTimeout(timeout); ws.off('message', handler); resolve(parsed); }
+    ws.on('message', handler);
+  });
+}
+async function match(mode) {
+  const port = server.address().port;
+  const first = await connect(port), second = await connect(port);
+  const joined = message(first, 'joined');
+  first.send(JSON.stringify({ type: 'create', name: 'Ace', mode }));
+  const { code, id } = await joined;
+  const start = message(first, 'start'), secondJoined = message(second, 'joined');
+  second.send(JSON.stringify({ type: 'join', code, name: 'Wing' }));
+  await secondJoined; await start;
+  return { first, second, room: rooms.get(code), id };
+}
+
+test('two real sockets join a room; server attributes kills and records results', async () => {
+  const { first, second, room, id } = await match('versus');
+  assert.equal(room.players.length, 2);
+  room.spawned = room.quota;
+  room.enemies.push({ id: 900, x: 340, y: 410, hp: 1, max: 1, speed: 0, drift: 0, fire: 100 });
+  room.bullets.push({ x: 340, y: 410, vx: 0, vy: 0, owner: id });
+  simulate(room);
+  assert.equal(room.players[0].kills, 1);
+  assert.equal(room.players[1].kills, 0);
+  assert.equal(room.score, 100);
+  room.time = 180;
+  const ended = message(second, 'end'); simulate(room);
+  assert.equal((await ended).winner, 'Ace');
+  const saved = JSON.parse(fs.readFileSync(process.env.SCORES_FILE, 'utf8'));
+  assert.equal(saved[0].winner, 'Ace');
+  assert.equal(saved[0].players[0].kills, 1);
+  const response = await fetch(`http://127.0.0.1:${server.address().port}/api/leaderboard`);
+  assert.equal((await response.json())[0].score, 100);
+  const page = await fetch(`http://127.0.0.1:${server.address().port}/multiplayer.html`);
+  assert.equal(page.status, 200);
+  assert.match(await page.text(), /CHOOSE YOUR FLIGHT/);
+  first.close(); second.close();
+});
+
+test('co-op records one shared score and rejects a third player', async () => {
+  const { first, second, room } = await match('coop');
+  const third = await connect(server.address().port);
+  const error = message(third, 'error');
+  third.send(JSON.stringify({ type: 'join', code: room.code, name: 'Third' }));
+  assert.match((await error).message, /full/);
+  room.score = 200;
+  const ended = message(first, 'end'); second.close();
+  assert.match((await ended).reason, /disconnected/);
+  const saved = JSON.parse(fs.readFileSync(process.env.SCORES_FILE, 'utf8'));
+  assert.ok(saved.some(row => row.mode === 'coop' && row.score === 200));
+  first.close(); third.close();
+});
+
+test('an escape ends co-op but the kill race continues until its timer', async () => {
+  const coop = await match('coop');
+  coop.room.spawned = coop.room.quota;
+  coop.room.enemies.push({ id: 901, x: 50, y: 630, hp: 1, max: 1, speed: 0, drift: 0, fire: 100 });
+  const lost = message(coop.first, 'end'); simulate(coop.room);
+  assert.match((await lost).reason, /escaped/);
+  coop.first.close(); coop.second.close();
+
+  const versus = await match('versus');
+  versus.room.spawned = versus.room.quota;
+  versus.room.enemies.push({ id: 902, x: 50, y: 630, hp: 1, max: 1, speed: 0, drift: 0, fire: 100 });
+  simulate(versus.room);
+  assert.equal(versus.room.ended, false);
+  assert.equal(versus.room.enemies.length, 0);
+  versus.first.close(); versus.second.close();
+});
+
+test.after(async () => {
+  clearInterval(timer);
+  for (const client of wss.clients) client.terminate();
+  await new Promise(resolve => wss.close(resolve));
+  await new Promise(resolve => server.close(resolve));
+  fs.rmSync(dir, { recursive: true, force: true });
+});
