+<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Neon Drift Multiplayer</title>
+<style>
+:root{font-family:ui-monospace,Consolas,monospace;color:#e9f8f3;background:#08121b}*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(circle at 50% 0,#17363c,#08121b 60%);padding:20px}main{max-width:1050px;margin:auto}header,.bar{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}header{padding:8px 0 20px}h1{margin:0;letter-spacing:3px;font-size:24px}h1 span,.accent{color:#9af5ca}a{color:#9af5ca}button,input,select{font:inherit;border:1px solid #3a5a62;background:#152831;color:#eefaf7;padding:11px;border-radius:4px}button{cursor:pointer}button:hover{border-color:#9af5ca}input{width:150px}button.primary{background:#9af5ca;color:#102820;font-weight:bold}button:disabled{opacity:.45;cursor:default}.bar{background:#12222d;padding:14px;margin-bottom:8px;font-size:13px;border:1px solid #334a55}.stage{position:relative}canvas{width:100%;display:block;aspect-ratio:16/10;background:#081b22;image-rendering:pixelated;border:1px solid #476269;touch-action:none}.overlay{position:absolute;inset:0;display:grid;place-items:center;background:#07121ac7;padding:15px}.overlay.hidden{display:none}.panel{width:min(560px,100%);background:#12232eea;padding:26px;border:1px solid #638d88;text-align:center;max-height:100%;overflow:auto}h2{font-size:26px;color:#9af5ca;margin:6px 0 12px}.row{display:flex;justify-content:center;flex-wrap:wrap;gap:8px;margin:12px 0}.note{color:#a8bfc2;font-size:12px;line-height:1.6}.error{color:#ff8d91;min-height:20px}.board{display:grid;gap:7px;text-align:left;max-height:210px;overflow:auto}.entry{border-bottom:1px solid #30484d;padding:5px 0;font-size:11px}.touch{display:flex;gap:8px;justify-content:space-between;margin-top:10px}.touch button{min-width:52px;touch-action:none}.touch .moves{display:flex;gap:5px}footer{color:#a8bfc2;font-size:12px;line-height:1.7;margin-top:12px}@media(max-width:600px){body{padding:8px}h1{font-size:18px}.bar{font-size:11px}.panel{padding:12px}canvas{aspect-ratio:4/5}header{padding-bottom:8px}}
+</style></head><body><main><header><h1>NEON <span>/</span> DRIFT <small class="accent">// TWO PILOTS</small></h1><a href="/index.html">← Solo campaign</a></header>
+<div class="bar"><div id="room">ROOM · —</div><div id="status">AWAITING PILOTS</div><div id="score">TEAM SCORE · 000000</div></div>
+<div class="stage"><canvas id="game" width="960" height="600"></canvas><div class="overlay" id="overlay"><div class="panel" id="panel"></div></div></div>
+<div class="touch"><div class="moves"><button data-key="ArrowLeft">◀</button><button data-key="ArrowUp">▲</button><button data-key="ArrowDown">▼</button><button data-key="ArrowRight">▶</button></div><div><button id="dash">DASH</button> <button id="nova">NOVA</button></div></div>
+<footer>Move: WASD or arrow keys · Dash: Space · Nova: X · Auto-fire is enabled. Share the room code with your second pilot. Both players need to connect to the same server.</footer></main>
+<script>
+(()=>{
+const $=id=>document.getElementById(id),ctx=$('game').getContext('2d'),canvas=$('game');
+let ws=null,id='',code='',mode='',snap=null,keys={},action=null,ended=false,stars=Array.from({length:80},()=>({x:Math.random()*960,y:Math.random()*600,r:Math.random()*2+1}));
+const clean=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+function panel(html){$('panel').innerHTML=html;$('overlay').classList.remove('hidden')}
+function lobby(message=''){
+ panel(`<h2>CHOOSE YOUR FLIGHT</h2><p class="note">Co-op: survive together and earn a team score.<br>Kill race: compete for kills in the same arena for three minutes.</p><div class="row"><input id="name" maxlength="20" placeholder="Pilot name" value="${clean(sessionStorage.getItem('pilotName')||'')}"><select id="mode"><option value="coop">Co-op</option><option value="versus">Kill race</option></select></div><div class="row"><button class="primary" id="create">CREATE ROOM</button><input id="code" maxlength="6" placeholder="Room code" value="${clean(new URLSearchParams(location.search).get('room')||'')}"><button id="join">JOIN ROOM</button></div><p class="error" id="error">${clean(message)}</p><h3>TOP RESULTS</h3><div id="board" class="board">Loading…</div>`);
+ $('create').onclick=()=>connect('create');$('join').onclick=()=>connect('join');fetch('/api/leaderboard').then(r=>r.json()).then(rows=>{if(!$('board'))return;$('board').innerHTML=rows.length?rows.slice(0,10).map(r=>`<div class="entry">${clean(r.mode==='coop'?'CO-OP':'KILL RACE')} · ${clean(r.players.map(p=>p.name+' '+p.kills).join(' / '))} · ${r.score} pts</div>`).join(''):'No completed games yet.'}).catch(()=>{if($('board'))$('board').textContent='Leaderboard unavailable'});
+ }
+function connect(type){
+ const name=$('name').value.trim(),roomCode=$('code').value.trim().toUpperCase(),selected=$('mode').value;
+ if(!name||type==='join'&&!/^[A-F0-9]{6}$/.test(roomCode)){ $('error').textContent='Enter a name and a six-character room code to join';return }
+ sessionStorage.setItem('pilotName',name);$('error').textContent='Connecting…';
+ ws=new WebSocket((location.protocol==='https:'?'wss:':'ws:')+'//'+location.host+'/socket');
+ ws.onopen=()=>ws.send(JSON.stringify({type,name,mode:selected,code:roomCode}));
+ ws.onmessage=ev=>{let m;try{m=JSON.parse(ev.data)}catch{return}
+  if(m.type==='error'){$('error')?$('error').textContent=m.message:panel('<h2>ERROR</h2><p>'+clean(m.message)+'</p>');ws.close()}
+  if(m.type==='joined'){id=m.id;code=m.code;mode=m.mode;ended=false;$('room').textContent='ROOM · '+code;history.replaceState(null,'','?room='+code);panel('<h2>ROOM '+code+'</h2><p>Waiting for pilot two…</p><p class="note">Share this page URL or the room code.</p><button id="copy">COPY INVITE LINK</button>');$('copy').onclick=()=>navigator.clipboard.writeText(location.href);}
+  if(m.type==='roster'){$('status').textContent=m.players.join(' + ')+(m.ready?' · READY':' · WAITING')}
+  if(m.type==='start'){$('overlay').classList.add('hidden');$('status').textContent=mode==='coop'?'CO-OP · SECTOR 01':'KILL RACE · 03:00'}
+  if(m.type==='state'){snap=m;$('score').textContent='TEAM SCORE · '+String(m.score).padStart(6,'0');$('status').textContent=mode==='coop'?'CO-OP · SECTOR '+String(m.sector).padStart(2,'0'):'KILL RACE · '+Math.ceil(m.remaining)+'s';}
+  if(m.type==='end'){ended=true;panel('<h2>RUN COMPLETE</h2><p>'+clean(m.reason)+'</p><p>TEAM SCORE · '+m.score+'</p>'+(m.winner?'<p>WINNER · '+clean(m.winner)+'</p>':'')+'<button class="primary" id="again">BACK TO LOBBY</button>');$('again').onclick=()=>{ws?.close();snap=null;history.replaceState(null,'',location.pathname);lobby()}}
+ };
+ ws.onclose=()=>{if(!ended&&id){ended=true;panel('<h2>CONNECTION LOST</h2><button id="again">BACK TO LOBBY</button>');$('again').onclick=()=>{id='';lobby()}}else if(!id&&$('error'))$('error').textContent='Could not connect to the multiplayer server'};
+ }
+function sendInput(){if(!ws||ws.readyState!==1||!snap||ended)return;const x=Number(!!(keys.KeyD||keys.ArrowRight))-Number(!!(keys.KeyA||keys.ArrowLeft));const y=Number(!!(keys.KeyS||keys.ArrowDown))-Number(!!(keys.KeyW||keys.ArrowUp));ws.send(JSON.stringify({type:'input',x,y,action}));action=null}
+setInterval(sendInput,50);
+document.addEventListener('keydown',e=>{if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space'].includes(e.code))e.preventDefault();keys[e.code]=true;if(!e.repeat&&e.code==='Space')action='dash';if(!e.repeat&&e.code==='KeyX')action='nova'});
+document.addEventListener('keyup',e=>keys[e.code]=false);window.addEventListener('blur',()=>keys={});
+for(const b of document.querySelectorAll('[data-key]')){b.addEventListener('pointerdown',e=>{e.preventDefault();keys[b.dataset.key]=true;b.setPointerCapture(e.pointerId)});for(const event of ['pointerup','pointercancel'])b.addEventListener(event,()=>keys[b.dataset.key]=false)}
+$('dash').onclick=()=>action='dash';$('nova').onclick=()=>action='nova';
+function draw(){ctx.fillStyle='#081b22';ctx.fillRect(0,0,960,600);ctx.strokeStyle='#123641';for(let y=0;y<600;y+=60){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(960,y);ctx.stroke()}
+ for(const s of stars){ctx.fillStyle='#426b77';ctx.fillRect(s.x,s.y,s.r,s.r);s.y+=s.r*.3;if(s.y>600)s.y=0}
+ if(snap){for(const e of snap.enemies){ctx.fillStyle='#ff9783';ctx.beginPath();ctx.moveTo(e.x,e.y+15);ctx.lineTo(e.x-17,e.y-12);ctx.lineTo(e.x+17,e.y-12);ctx.fill();ctx.fillStyle='#253e45';ctx.fillRect(e.x-19,e.y-25,38,5);ctx.fillStyle='#9af5ca';ctx.fillRect(e.x-19,e.y-25,38*e.hp/e.max,5)}
+ for(const b of snap.bullets){ctx.fillStyle=b.owner?'#b9ffe1':'#ff6e77';ctx.fillRect(b.x-3,b.y-6,6,12)}
+ snap.players.forEach((p,i)=>{ctx.fillStyle=p.id===id?'#9af5ca':'#9eb6ff';ctx.beginPath();ctx.moveTo(p.x,p.y-20);ctx.lineTo(p.x-16,p.y+17);ctx.lineTo(p.x+16,p.y+17);ctx.fill();ctx.font='13px monospace';ctx.textAlign='center';ctx.fillStyle='#fff';ctx.fillText(p.name+' · '+p.kills+' KOs',p.x,p.y-38);ctx.fillText('♥'.repeat(Math.max(0,p.hp)),p.x,p.y+35)})}
+ requestAnimationFrame(draw)}lobby();draw();
+})();
+</script></body></html>
