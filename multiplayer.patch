+const { test, expect } = require('@playwright/test');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+
+test('two browser pilots join a kill race and see the same arena', async ({ browser }) => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'neondrift-browser-'));
+  process.env.PORT = '0'; process.env.SCORES_FILE = path.join(dir, 'scores.json');
+  const { server, wss, timer } = require('../server/index.cjs');
+  const base = `http://127.0.0.1:${server.address().port}/multiplayer.html`;
+  const first = await browser.newPage(), second = await browser.newPage();
+  const errors = [];
+  first.on('pageerror', e => errors.push(e.message));
+  second.on('pageerror', e => errors.push(e.message));
+  try {
+    await first.goto(base);
+    await first.locator('#name').fill('Ace');
+    await first.locator('#mode').selectOption('versus');
+    await first.locator('#create').click();
+    await expect(first.locator('#panel')).toContainText('Waiting for pilot two');
+    const code = (await first.locator('#room').innerText()).split('·')[1].trim();
+    await second.goto(base);
+    await second.locator('#name').fill('Wing');
+    await second.locator('#code').fill(code);
+    await second.locator('#join').click();
+    await expect(first.locator('#overlay')).toBeHidden();
+    await expect(second.locator('#overlay')).toBeHidden();
+    await expect(first.locator('#status')).toContainText('KILL RACE');
+    await expect(second.locator('#status')).toContainText('KILL RACE');
+    await first.keyboard.press('Space');
+    await expect(first.locator('#score')).toContainText('TEAM SCORE');
+    expect(errors).toEqual([]);
+  } finally {
+    await first.close(); await second.close(); clearInterval(timer);
+    for (const client of wss.clients) client.terminate();
+    await new Promise(resolve => wss.close(resolve));
+    await new Promise(resolve => server.close(resolve));
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
